# Configuración del Entorno - Microcontrollers RAG Assistant (Día 12)

# Proveedor de Embeddings y Credenciales
EMBEDDING_PROVIDER=google
DEFAULT_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_API_KEY=

# Control de Fallback para pruebas (false en producción/desarrollo, nunca ocultar errores de API)
ALLOW_TEST_EMBEDDINGS=false

# Rutas de Almacenamiento
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_METADATA_DIR=./data/metadata
STORAGE_VECTOR_DIR=./storage/vector_store
STORAGE_LEXICAL_DIR=./storage/lexical_index

# Parámetros de Chunking y Recuperación Vectorial Básica (Día 12)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5

# Configuración reservada para sesiones futuras (Día 13+)
DEFAULT_LLM_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
TOP_K_RERANKED=5
SIMILARITY_THRESHOLD=0.75
HYBRID_ALPHA=0.5
ENFORCE_STRICT_ELECTRICAL_CHECK=true
ENFORCE_CITATION_VALIDATION=true
