# Configuración del Entorno - Microcontrollers RAG Copilot

# Proveedor LLM y Embeddings
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-2.0-flash
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Rutas de Almacenamiento
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_METADATA_DIR=./data/metadata
STORAGE_VECTOR_DIR=./storage/vector_store
STORAGE_LEXICAL_DIR=./storage/lexical_index

# Parámetros de Recuperación RAG
TOP_K_RETRIEVAL=10
TOP_K_RERANKED=5
SIMILARITY_THRESHOLD=0.75
HYBRID_ALPHA=0.5

# Seguridad y Validación
ENFORCE_STRICT_ELECTRICAL_CHECK=true
ENFORCE_CITATION_VALIDATION=true
